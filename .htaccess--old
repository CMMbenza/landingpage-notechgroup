RewriteEngine On

# Redirige les accès directs avec .php vers l'URL sans .php (SEO / Propreté)
Cond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[\s?]
RewriteRule ^ %1 [R=301,L]

# Si le fichier sans .php existe, charge la version .php en interne
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]